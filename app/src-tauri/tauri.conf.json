{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notable",
  "version": "0.1.0",
  "identifier": "io.github.malvarezdam.notable",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Notable",
        "width": 900,
        "height": 700,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "malvarezdam",
    "copyright": "Copyright © 2026 malvarezdam. Licencia MIT.",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "Education",
    "shortDescription": "Gestor de notas y calificaciones",
    "longDescription": "Organiza tus ramos y evaluaciones, calcula promedios simples o ponderados y cuánto necesitas para llegar a tu objetivo. Funciona sin internet; la sincronización entre dispositivos es opcional.",
    "homepage": "https://github.com/malvarezdam/Notable",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
